@model ASC.WebHuyThuanPhuoc.Areas.Promotions.Models.PromotionsViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    Layout = "_SecureLayout";
    ViewData["Title"] = "Promotions";
}

<div class="row"></div>

<div class="row padding-top-20px">
    <div class="row z-depth-3 white">
        <div class="section white-text padding-left-10px blue-grey lighten-1">
            <h5>Promotions</h5>
        </div>

        <div class="divider"></div>

        <div class="col s12 padding-bottom-15px">
            <table class="highlight centered" id="tblPromotions">
                <thead>
                    <tr>
                        <th>Row Key</th>
                        <th>Type</th>
                        <th>Header</th>
                        <th>Content</th>
                        <th>Is Deleted</th>
                        <th>Edit</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Promotions != null && Model.Promotions.Any())
                    {
                        foreach (var promotion in Model.Promotions)
                        {
                            <tr>
                                <td>@promotion.RowKey</td>
                                <td>@promotion.PartitionKey</td>
                                <td>@promotion.Header</td>
                                <td>@promotion.Content</td>
                                <td>@promotion.IsDeleted</td>
                                <td>
                                    <button type="button"
                                            class="btn-small teal edit-promotion"
                                            data-rowkey="@promotion.RowKey"
                                            data-partitionkey="@promotion.PartitionKey"
                                            data-header="@promotion.Header"
                                            data-content="@promotion.Content"
                                            data-isdeleted="@promotion.IsDeleted">
                                        Edit
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">No Records</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="row padding-top-20px">
    <div class="row z-depth-3 white">
        <div class="section white-text padding-left-10px blue-grey lighten-1">
            <h5>Promotion Details</h5>
        </div>

        <div class="divider"></div>

        <div class="col s12 padding-bottom-15px">
            <form asp-area="Promotions"
                  asp-controller="Promotions"
                  asp-action="Promotion"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="PromotionInContext.RowKey" type="hidden" />
                <input asp-for="IsEdit" type="hidden" />

                <div class="row">
                    <div class="input-field col s4">
                        <select asp-for="PromotionInContext.PartitionKey"
                                asp-items="@(new SelectList(ViewBag.PromotionTypes, "Name", "Name", Model.PromotionInContext.PartitionKey))"
                                class="validate"
                                required="required">
                            <option value="">Please select one</option>
                        </select>
                        <label asp-for="PromotionInContext.PartitionKey"></label>
                    </div>

                    <div class="input-field col s8">
                        <input asp-for="PromotionInContext.Header"
                               class="validate"
                               required="required" />
                        <label asp-for="PromotionInContext.Header"></label>
                    </div>

                    <div class="input-field col s12">
                        <textarea asp-for="PromotionInContext.Content"
                                  class="materialize-textarea validate"
                                  required="required"></textarea>
                        <label asp-for="PromotionInContext.Content"></label>
                    </div>

                    <div class="input-field col s12">
                        <label>
                            <input asp-for="PromotionInContext.IsDeleted" type="checkbox" />
                            <span>Is Deleted</span>
                        </label>
                    </div>

                    <div class="input-field col s12 right-align">
                        <button class="btn waves-effect waves-light btnSubmit"
                                type="submit">
                            Create
                            <i class="material-icons right">send</i>
                        </button>
                    </div>

                    <div class="row col s12 right-align" asp-validation-summary="All"></div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('select').formSelect();
            M.updateTextFields();

            $('.edit-promotion').click(function () {
                var rowKey = $(this).data('rowkey');
                var partitionKey = $(this).data('partitionkey');
                var header = $(this).data('header');
                var content = $(this).data('content');
                var isDeleted = $(this).data('isdeleted');

                $('#IsEdit').val('true');
                $('#PromotionInContext_RowKey').val(rowKey);
                $('#PromotionInContext_PartitionKey').val(partitionKey);
                $('#PromotionInContext_Header').val(header);
                $('#PromotionInContext_Content').val(content);

                $('#PromotionInContext_IsDeleted').prop(
                    'checked',
                    isDeleted === true ||
                    isDeleted === 'True' ||
                    isDeleted === 'true'
                );

                $('select').formSelect();
                M.updateTextFields();

                $('.btnSubmit').html('Save <i class="material-icons right">save</i>');
            });
        });
    </script>
}